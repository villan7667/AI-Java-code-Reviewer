# ==============================================================================
# Local & Deployment Environment Template
# Copy these keys into your local .env file or environment settings (Render / Railway)
# ==============================================================================

# ---- Database Configuration ----
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai_code_reviewer?retryWrites=true&w=majority

# ---- JWT Authentication ----
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400000

# ---- Gemini AI Configuration ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---- Server Port ----
PORT=8080